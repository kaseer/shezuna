# Resend API key. Required for the contact form to send email.
RESEND_API_KEY=

# Inbox that receives enquiries.
CONTACT_TO_EMAIL=ops@shezuna.co.uk

# From address. Use a domain you have verified in Resend.
CONTACT_FROM_EMAIL=Shezuna Website <no-reply@shezuna.co.uk>

# Optional. Used when the Resend account can only email its owner.
RESEND_TEST_RECIPIENT=
